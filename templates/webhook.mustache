{{{allow_accounts_same_email_warning}}}

<p>{{#str}}webhook_desc, contentmarketplace_goonetwo{{/str}}</p>

{{#webhook_exists}}
    {{#str}} webhook_already_created, contentmarketplace_goonetwo {{/str}}
    <br />
    <pre>{{ webhook_data }}</pre>
    <br />
    {{#webhook_problems.0}}
        <div class="alert alert-warning">
            {{#str}}webhook_incorrect, contentmarketplace_goonetwo{{/str}}
            <ul>
                {{#webhook_problems}}
                    <li>{{.}}</li>
                {{/webhook_problems}}
            </ul>
            {{#str}}webhook_fix_desc, contentmarketplace_goonetwo{{/str}}
        </div>
    {{/webhook_problems.0}}
{{/webhook_exists}}

{{{webhook_button}}}

<div class="tcm-goonetwo-webhook-settings">
    {{{webhook_settings_form}}}
</div>

<p class="tcm-goonetwo-webhook-log-link"><a href="{{webhook_log_url}}">{{#str}}webhook_log_view, contentmarketplace_goonetwo{{/str}}</a></p>
